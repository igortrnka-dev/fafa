# Heslo do admin rozhrania (povinné)
ADMIN_PASSWORD=zmen-toto-heslo
# Náhodný tajný kľúč na podpis prihlasovacej cookie (povinné, min. 20 znakov)
SESSION_SECRET=zmen-toto-na-dlhy-nahodny-retazec
# Verejná adresa, na ktorej aplikácia beží (používa sa pri generovaní linkov do SMS)
PUBLIC_URL=https://poloha.vasafirma.sk
# Port (voliteľné)
PORT=3000
# Cesta k databáze (voliteľné)
DB_PATH=./data/poloha.sqlite
# Názov firmy v ceste linku kuriéra (napr. deliveryverification → /deliveryverification/<kód>)
BRAND_SLUG=deliveryverification
